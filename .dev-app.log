  if ([string]::IsNullOrWhiteSpace($p)) { return '' }
  try { return ([System.IO.Path]::GetFullPath($p)).TrimEnd('\\').ToLowerInvariant() } catch { return $p.Trim().TrimEnd('\\').ToLowerInvariant() }
